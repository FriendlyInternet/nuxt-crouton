{
  "packages": ["crouton-pages", "crouton-editor"],
  "collections": [
    {
      "key": "mainItems",
      "heading": "Main Items",
      "create": { "name": "e2e item" }
    }
  ],
  "surfaces": [
    {
      "name": "pages workspace renders",
      "path": "/admin/{team}/workspace",
      "expect": { "visible": "[id$='-panel-pages-sidebar']" }
    },
    {
      "name": "page editor mounts the real block editor, not the stub",
      "path": "/admin/{team}/workspace",
      "click": ["[aria-label='Create Page']", "[data-review='editor-tab-content']"],
      "expect": { "visible": ".crouton-editor-blocks .ProseMirror", "a11y": false }
    }
  ]
}
