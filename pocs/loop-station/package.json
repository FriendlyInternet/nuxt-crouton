{
  "name": "loop-station",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare 2>/dev/null || true",
    "typecheck": "nuxt typecheck",
    "cf:staging": "NITRO_PRESET=cloudflare_module nuxt build && npx wrangler deploy --env staging",
    "cf:version": "NITRO_PRESET=cloudflare_module nuxt build && npx wrangler versions upload --env staging"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fyit/crouton-devtools": "workspace:*",
    "@fyit/crouton-themes": "workspace:*",
    "@nuxt/ui": "catalog:",
    "@vue-flow/core": "^1.41.2",
    "nuxt": "catalog:",
    "nuxt-charts": "^2.1.2",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "wrangler": "catalog:"
  }
}
