[
  [
    "package.json",
    "{
  "name": "demo-plain",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "postinstall": "nuxt prepare 2>/dev/null || true",
    "cf:deploy": "NITRO_PRESET=cloudflare_module nuxt build && npx wrangler --cwd .output deploy && node scripts/sync-wrangler-ids.mjs && npx wrangler d1 migrations apply demo-plain-db --remote",
    "cf:staging": "NUXT_PUBLIC_CROUTON_REVIEW=true NITRO_PRESET=cloudflare_module nuxt build && node scripts/inject-wrangler-env.mjs && npx wrangler deploy --config .output/server/wrangler.json --env staging && node scripts/sync-wrangler-ids.mjs && node scripts/inject-wrangler-env.mjs && npx wrangler d1 migrations apply demo-plain-staging-db --env staging --remote",
    "sync:ids": "node scripts/sync-wrangler-ids.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx wrangler d1 migrations apply demo-plain-db --local",
    "db:migrate:prod": "npx wrangler d1 migrations apply demo-plain-db --remote",
    "db:migrate:staging": "npx wrangler d1 migrations apply demo-plain-staging-db --env staging --remote",
    "db:seed": "crouton-seed --db demo-plain-db",
    "db:seed:staging": "crouton-seed --db demo-plain-staging-db --remote"
  },
  "dependencies": {
    "@fyit/crouton-core": "workspace:*",
    "@fyit/crouton-i18n": "workspace:*",
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.2.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fyit/crouton-cli": "workspace:*",
    "@fyit/crouton-devtools": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.64.0"
  }
}
",
  ],
  [
    "tsconfig.json",
    "{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json"
}
",
  ],
  [
    "nuxt.config.ts",
    "import { fileURLToPath } from 'node:url'
import { dirname, resolve } from 'node:path'

const __dirname = dirname(fileURLToPath(import.meta.url))
const cfStubs = resolve(__dirname, 'server/utils/_cf-stubs')

// https://nuxt.com/docs/api/configuration/nuxt-config
export default defineNuxtConfig({
  modules: ['@fyit/crouton-devtools'],
  css: ['~/assets/css/main.css'],
  compatibilityDate: '2025-07-15',
  devtools: { enabled: true },
  extends: [
    '@fyit/crouton-core',
    '@fyit/crouton-i18n'
  ],
  hub: {
    db: 'sqlite',
    kv: true
  },

  // Disable OG Image to reduce bundle size for Cloudflare (saves ~4MB)
  ogImage: { enabled: false },

  // Disable passkeys for Cloudflare Workers (tsyringe incompatibility)
  croutonAuth: {
    methods: {
      passkeys: false
    }
  },

  // Cloudflare Workers deployment — stub passkey/webauthn packages (tsyringe is
  // incompatible with workerd). Preset comes from NITRO_PRESET at build time.
  nitro: {
    alias: {
      '@better-auth/passkey/client': resolve(cfStubs, 'client'),
      '@better-auth/passkey': cfStubs,
      'tsyringe': cfStubs,
      'reflect-metadata': cfStubs,
      '@peculiar/x509': cfStubs,
      '@simplewebauthn/server': cfStubs,
      'papaparse': cfStubs
    }
  }
})
",
  ],
  [
    "crouton.config.js",
    "export default {
  // Which crouton packages this app uses is decided by \`extends\` in nuxt.config.ts
  // (#2286). A package's prompted configuration lands under \`features.<alias>\`.

  // Collections to generate (add your collections here)
  // Example:
  // collections: [
  //   { name: 'products', fieldsFile: './schemas/products.json' }
  // ],
  collections: [],

  // Target layers (add after creating collections)
  // Example:
  // targets: [
  //   { layer: 'shop', collections: ['products'] }
  // ],
  targets: [],

  dialect: 'sqlite'
}
",
  ],
  [
