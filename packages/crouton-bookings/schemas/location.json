{
  "title": {
    "type": "string",
    "meta": {
      "required": true,
      "translatable": true,
      "label": "Title",
      "maxLength": 200,
      "area": "main",
      "group": "basic"
    }
  },
  "color": {
    "type": "string",
    "meta": {
      "label": "Color",
      "component": "ColorPicker",
      "area": "sidebar",
      "group": "basic",
      "help": "Color used for this location's bookings in the calendar"
    }
  },
  "street": {
    "type": "string",
    "meta": {
      "translatable": true,
      "label": "Street",
      "area": "main",
      "group": "address"
    }
  },
  "zip": {
    "type": "string",
    "meta": {
      "translatable": true,
      "label": "ZIP Code",
      "area": "main",
      "group": "address"
    }
  },
  "city": {
    "type": "string",
    "meta": {
      "translatable": true,
      "label": "City",
      "area": "main",
      "group": "address"
    }
  },
  "location": {
    "type": "text",
    "meta": {
      "label": "Coordinates (GeoJSON)",
      "area": "main",
      "group": "address"
    }
  },
  "content": {
    "type": "richText",
    "meta": {
      "translatable": true,
      "label": "Content",
      "area": "main",
      "group": "content"
    }
  },
  "allowedMemberIds": {
    "type": "array",
    "meta": {
      "label": "Allowed Member IDs",
      "area": "sidebar",
      "group": "access",
      "help": "User IDs that are allowed to book at this location"
    }
  },
  "slots": {
    "type": "repeater",
    "meta": {
      "label": "Available Time Slots",
      "repeaterComponent": "Slot",
      "addLabel": "Add Time Slot",
      "sortable": true,
      "area": "main",
      "group": "scheduling",
      "help": "Leave empty for a location booked by the whole day.",
      "properties": {
        "label": { "type": "string", "required": true, "label": "Slot Name" }
      }
    }
  },
  "products": {
    "type": "repeater",
    "meta": {
      "label": "Products",
      "area": "main",
      "group": "scheduling",
      "help": "Products this location offers, each with its own stock.",
      "properties": {
        "product": { "type": "string", "required": true, "label": "Product" },
        "stock": { "type": "number", "required": true, "label": "Stock", "default": 1 }
      }
    }
  },
  "openDays": {
    "type": "array",
    "meta": {
      "nullable": true,
      "label": "Open Days",
      "area": "main",
      "group": "scheduling",
      "component": "CroutonBookingsOpenDaysPicker",
      "help": "Days of the week this location is open. Empty/null means every day."
    }
  },
  "slotSchedule": {
    "type": "json",
    "meta": {
      "nullable": true,
      "label": "Slot Schedule",
      "area": "main",
      "group": "scheduling",
      "component": "CroutonBookingsScheduleGrid",
      "help": "Per-slot day-of-week availability. Null means all slots follow open days."
    }
  },
  "blockedDates": {
    "type": "repeater",
    "meta": {
      "nullable": true,
      "label": "Blocked Dates",
      "repeaterComponent": "BlockedDateInput",
      "addLabel": "Add Blocked Period",
      "sortable": false,
      "area": "main",
      "group": "scheduling",
      "help": "Date ranges when the location is closed (holidays, maintenance, etc.)"
    }
  },
  "offerFullDay": {
    "type": "boolean",
    "meta": {
      "label": "Offer a full-day option",
      "default": false,
      "area": "main",
      "group": "scheduling",
      "help": "Adds a full-day option next to the named slots. It blocks the other slots on that date, and any booked slot blocks it."
    }
  },
  "maxBookingsPerMonth": {
    "type": "number",
    "meta": {
      "label": "Max Bookings Per Month",
      "area": "sidebar",
      "group": "limits",
      "help": "Maximum bookings a user can make per calendar month. Empty = unlimited."
    }
  }
}
