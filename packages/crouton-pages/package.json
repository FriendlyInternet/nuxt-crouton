{
  "name": "@fyit/crouton-pages",
  "version": "0.1.0",
  "description": "Page management system for Nuxt Crouton with page types, tree layout, and CMS functionality",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./seed": {
      "import": "./seed/index.ts",
      "types": "./seed/index.ts"
    },
    "./collections/*/types": "./collections/*/types.ts",
    "./collections/*/server/database/schema": "./collections/*/server/database/schema.ts",
    "./collections/*/server/database/queries": "./collections/*/server/database/queries.ts"
  },
  "files": [
    "app",
    "server",
    "collections",
    "schemas",
    "seed",
    "i18n",
    "nuxt.config.ts",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "cms",
    "pages",
    "crouton"
  ],
  "author": "FYIT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriendlyInternet/nuxt-crouton.git",
    "directory": "packages/crouton-pages"
  },
  "bugs": {
    "url": "https://github.com/FriendlyInternet/nuxt-crouton/issues"
  },
  "homepage": "https://github.com/FriendlyInternet/nuxt-crouton#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@fyit/crouton-core": "workspace:*",
    "@fyit/crouton-editor": "workspace:*",
    "@nuxt/ui": "^4.3.0",
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@fyit/crouton-i18n": "workspace:*",
    "@tiptap/extension-highlight": "^3.20.0",
    "@vueuse/core": "^13.3.0"
  }
}
