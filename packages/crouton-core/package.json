{
  "name": "@fyit/crouton-core",
  "version": "0.1.0",
  "description": "Base CRUD layer for FYIT scaffolded collections",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./shared/manifest": "./shared/manifest.ts",
    "./shared/seed": "./shared/seed/index.ts",
    "./shared/utils/date": "./shared/utils/date.ts",
    "./shared/utils/fs": "./shared/utils/fs.ts",
    "./shared/utils/d1": "./shared/utils/d1.ts",
    "./shared/utils/query-registry": "./shared/utils/query-registry.ts",
    "./app/types/app": "./app/types/app.ts",
    "./app/types/block-definition": "./app/types/block-definition.ts",
    "./app/types/layout": "./app/types/layout.ts",
    "./app/types/layout-block": "./app/types/layout-block.ts",
    "./app/utils/layout-tree": "./app/utils/layout-tree.ts",
    "./app/composables/*": {
      "types": "./dist/app/composables/*.d.ts",
      "import": "./dist/app/composables/*.mjs"
    },
    "./server/database/schema/*": {
      "types": "./dist/server/database/schema/*.d.ts",
      "import": "./dist/server/database/schema/*.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "app",
    "server",
    "shared",
    "types",
    "dist",
    "nuxt.config.ts",
    "crouton-hooks.d.ts"
  ],
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "crouton",
    "scaffolding"
  ],
  "author": "FYIT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriendlyInternet/nuxt-crouton.git",
    "directory": "packages/crouton-core"
  },
  "bugs": {
    "url": "https://github.com/FriendlyInternet/nuxt-crouton/issues"
  },
  "homepage": "https://github.com/FriendlyInternet/nuxt-crouton#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fyit/crouton-admin": "workspace:*",
    "@fyit/crouton-auth": "workspace:*",
    "@fyit/crouton-i18n": "workspace:*",
    "@iconify-json/lucide": "^1.2.68",
    "@nuxt/kit": "^4.0.0",
    "@nuxthub/core": "^0.10.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/seo": "^6.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/core": "^13.3.0",
    "@vueuse/integrations": "^13.3.0",
    "@vueuse/nuxt": "^13.3.0",
    "cropperjs": "^2.1.0",
    "papaparse": "^5.5.3",
    "pluralize": "^8.0.0",
    "sortablejs": "^1.15.6",
    "uqr": "^0.1.2"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@fyit/crouton-cli": "workspace:*",
    "@types/papaparse": "^5.5.2",
    "@types/pluralize": "^0.0.33",
    "@types/sortablejs": "^1.15.8",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "^4.19.2",
    "unbuild": "^3.6.1",
    "vitest": "catalog:"
  }
}
