{
  "name": "nuxt-crouton-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Nuxt Crouton - Reusable CRUD layers for Nuxt 4",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "crud",
    "scaffolding",
    "translations",
    "i18n"
  ],
  "author": "FYIT",
  "license": "MIT",
  "homepage": "https://github.com/FriendlyInternet/nuxt-crouton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriendlyInternet/nuxt-crouton.git"
  },
  "bugs": {
    "url": "https://github.com/FriendlyInternet/nuxt-crouton/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm -r --filter '!./pocs/**' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "pnpm -r --filter './apps/*' --filter @fyit/crouton-cli typecheck",
    "typecheck:fixtures": "pnpm -r --filter './fixtures/*' typecheck",
    "typecheck:mcp": "pnpm --filter @fyit/crouton-mcp typecheck",
    "poc:scaffold-deploy": "node scripts/scaffold-poc-deploy.mjs",
    "db:clone": "node scripts/db-clone.mjs",
    "db:counts": "node scripts/db-counts.mjs",
    "app:shots": "node scripts/app-shots.mjs",
    "preview": "node scripts/app-preview.mjs",
    "publish:packages": "./scripts/publish-packages.sh",
    "publish:packages:dry": "./scripts/publish-packages.sh --dry-run",
    "publish:packages:skip-build": "./scripts/publish-packages.sh --skip-build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset version && pnpm publish:packages",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "changelog": "changelogithub",
    "check:publint": "publint ./packages/crouton-core",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.30.0",
    "@nuxt/eslint-config": "^1.2.0",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "changelogithub": "^14.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "fallow": "^2.104.0",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "publint": "^0.3.16",
    "sharp": "^0.34.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.44",
      "nuxt": "^4.6.2",
      "@nuxt/schema": "^4.6.2",
      "@nuxt/nitro-server": "^4.6.2",
      "@nuxt/ui": "^4.11.3",
      "@nuxt/devtools": "^3.4.2",
      "@nuxt/devtools-kit": "^3.4.2",
      "unimport": "4.1.1",
      "youch": "4.1.0-beta.13",
      "zod": "4.6.7",
      "@tiptap/core": "3.32.0",
      "@tiptap/pm": "3.32.0",
      "@tiptap/vue-3": "3.32.0",
      "drizzle-orm": "^0.45.4",
      "@nuxtjs/i18n": "^10.6.0",
      "@fyit/crouton-sales>vue-i18n": "^11.4.14",
      "lodash-es": "^4.18.1",
      "protocol-buffers-schema": "^3.6.1",
      "@simplewebauthn/server": "^13.3.2",
      "flatted": "^3.4.2",
      "proxy-addr": "^2.0.8",
      "undici@7": "^7.30.1",
      "undici@8": "^8.12.2",
      "tar@7": "^7.5.21"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "es5-ext",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "patchedDependencies": {
      "unstorage": "patches/unstorage.patch"
    }
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
